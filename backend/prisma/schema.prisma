generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITOYEN
  PROFESSIONNEL
  REGIE
  FORMATEUR
  AUTORITE
  ADMIN
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  firstName      String?
  lastName       String?
  phone          String?
  role           UserRole       @default(CITOYEN)
  profilePicture String?
  points         Int            @default(0)
  badge          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  posts          Post[]
  comments       Comment[]
  signalements   Signalement[]
  notifications  Notification[]
  subscription   Subscription?
  formations     Formation[]    @relation("UserFormations")
}

enum SignalementType {
  DEGRADE
  OBSOLETE
  DANGEREUX
  ILLEGAL
  TRAVAUX
  BON_ETAT
}

enum SignalementStatus {
  PENDING
  VALIDATED
  REJECTED
  RESOLVED
}

model Signalement {
  id          String            @id @default(uuid())
  type        SignalementType
  description String
  lat         Float
  lng         Float
  imageUrl    String?
  videoUrl    String?
  status      SignalementStatus @default(PENDING)
  votesCount  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  authorId    String?
  author      User?             @relation(fields: [authorId], references: [id])
}

enum FormationCategory {
  PANNEAUTIQUE
  ENVIRONNEMENT
  VIE_SAINE
  INFRASTRUCTURE
}

model Formation {
  id            String            @id @default(uuid())
  title         String
  description   String
  category      FormationCategory @default(PANNEAUTIQUE)
  content       Json?
  duration      String?
  capacity      Int               @default(50)
  enrolledCount Int               @default(0)
  price         Float             @default(0)
  currency      String            @default("XOF")
  isFree        Boolean           @default(true)
  imageUrl      String?
  createdAt     DateTime          @default(now())
  enrolledUsers User[]            @relation("UserFormations")
}

enum PostTheme {
  ENVIRONMENT
  HEALTH
  FAMILY
}

model Post {
  id         String    @id @default(uuid())
  content    String
  mediaUrl   String?
  theme      PostTheme @default(ENVIRONMENT)
  likesCount Int       @default(0)
  createdAt  DateTime  @default(now())
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  comments   Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
}

enum NotificationType {
  INFO
  SIGNALEMENT
  FORMATION
  PAYMENT
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PROFESSIONAL
  ENTERPRISE
}

model Subscription {
  id        String             @id @default(uuid())
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id])
}

enum PanelType {
  CLASSIQUE
  DIGITAL
  ABRIBUS
  TOTEM
  AUTRE
}

enum PanelStatus {
  DISPONIBLE
  LOUE
  MAINTENANCE
}

model Panel {
  id        String      @id @default(uuid())
  type      PanelType   @default(CLASSIQUE)
  format    String      @default("4x3")
  regime    String      @default("prive")
  etat      PanelStatus @default(DISPONIBLE)
  lat       Float
  lng       Float
  price     Float?
  imageUrl  String?
  createdAt DateTime    @default(now())
}

model Zone {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("commerciale")
  boundary  Json     // To store the array of coordinates
  createdAt DateTime @default(now())
}
