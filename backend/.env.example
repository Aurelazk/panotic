# Base de données PostgreSQL (avec PostGIS)
DATABASE_URL="postgresql://user:password@host:5432/panotic?schema=public"

# Clé secrète pour les tokens JWT
JWT_SECRET="changez-moi-par-une-chaine-aleatoire-securisee"

# Port du serveur
PORT=3000

# Environnement (development | production)
NODE_ENV=development
