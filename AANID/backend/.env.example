# ─── Serveur ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Neon PostgreSQL (recommandé) ─────────────────────────────
# Créer un projet sur https://neon.tech → copier la connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ─── JWT (auth w-d) — générer avec: openssl rand -hex 32 ─────
AANID_ACCESS_SECRET=change-me-access-secret-min-32-chars
AANID_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# ─── Redis (optionnel, gateway) ────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── CORS (production) ───────────────────────────────────────
# CORS_ORIGIN=https://your-app.onrender.com
